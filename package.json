{
  "name": "decision-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local catalog of four independent, offline decision workbenches.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test-catalog.mjs && node scripts/run-apps.mjs test",
    "check": "node scripts/check-hub.mjs && node scripts/run-apps.mjs check",
    "test:browser": "node scripts/browser-smoke.mjs",
    "build:standalone": "node scripts/run-apps.mjs build:standalone",
    "versions:sync": "node scripts/versions.mjs sync",
    "versions:check": "node scripts/versions.mjs check"
  },
